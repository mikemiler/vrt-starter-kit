# Logins for pages behind a login (see README, "Pages behind a login"). These win over auth.json.
# Copy to .env (git-ignored). <NAME> is the login name upper-cased, other characters become "_".
VRT_LOGIN_CMS_URL=http://localhost:3150/admin/login
VRT_LOGIN_CMS_EMAIL=
VRT_LOGIN_CMS_PASSWORD=
# Only for forms that are not standard (CSS selectors); _SUCCESS_SELECTOR = visible once logged in.
# VRT_LOGIN_CMS_EMAIL_SELECTOR=
# VRT_LOGIN_CMS_PASSWORD_SELECTOR=
# VRT_LOGIN_CMS_SUBMIT_SELECTOR=
# VRT_LOGIN_CMS_SUCCESS_SELECTOR=
